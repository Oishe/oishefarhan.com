{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oishefarhan-com",
  "compatibility_date": "2026-08-20",

  // Assets-only Worker: there is no `main` script, because there is no server.
  // Every page here is a file on disk, built by `npm run build`.
  "assets": {
    // Quarto's output-dir. vault/_quarto.yml sets `output-dir: ../generated/site`,
    // so this path and that one have to move together.
    "directory": "./generated/site",

    // Quarto emits directory-style pages -- about.qmd becomes about/index.html --
    // and links to them with an explicit ./about/index.html. The default
    // auto-trailing-slash handling serves those at /about/ and redirects the
    // explicit form onto it, which is what we want.
    //
    "html_handling": "auto-trailing-slash",

    // Serves generated/site/404.html, from vault/404.md, with a 404 status at
    // whatever path was missed. Quarto writes that page's URLs site-absolute
    // because it is named 404 -- which is what makes it safe to serve from a
    // path it was not built at. Renaming the source breaks that silently.
    "not_found_handling": "404-page"
  },

  "routes": [
    { "pattern": "oishefarhan.com", "custom_domain": true },
    { "pattern": "www.oishefarhan.com", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
