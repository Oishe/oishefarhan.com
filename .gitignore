# Tooling and session scratch
.tools/
.serena/
.playwright-mcp/
.DS_Store

# Generated publishing artifacts. Everything under generated/ is derivable:
# scripts/prepare-publication.ts rebuilds the staged tree and link map from the
# vault, and `quarto render` rebuilds generated/quarto/.
generated/

# Node dependencies for the publication-prep scripts.
node_modules/

# Python / Quarto / Jupyter working state.
# vault/_freeze/ is deliberately absent: section 27 requires committing frozen
# output for published computational documents so CI need not execute them.
**/.venv/
**/.quarto/
**/.jupyter_cache/
**/_site/
**/*.quarto_ipynb

# Obsidian workspace churn (section 3.3); real vault config stays tracked.
**/.obsidian/cache/
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# Community plugin and theme code is third-party and reinstallable. The settings
# that describe the setup stay tracked: community-plugins.json, each plugin's
# data.json, and each plugin's manifest.json -- the manifest carries the id,
# canonical name, and version, so PLUGINS.md never hand-copies a version number
# that then drifts. Obsidian rewrites the manifest on update, so the diff
# records the bump. See vault/.obsidian/PLUGINS.md.
vault/.obsidian/plugins/**
!vault/.obsidian/plugins/*/
!vault/.obsidian/plugins/*/data.json
!vault/.obsidian/plugins/*/manifest.json
vault/.obsidian/themes/

# Privacy boundary. Any directory whose name ends in `_hidden` -- including the
# bare `_hidden` -- may be placed anywhere in the vault; this also protects
# private attachments and Quarto frozen output. The leading `*` matches the
# empty string, so this one rule covers `_hidden/` and `drafts_hidden/` alike.
vault/**/*_hidden/

# Per-file privacy boundary. `*.hidden.md` / `*.hidden.qmd` are the single-note
# equivalent of a `*_hidden/` directory: local-only, never committed, never
# published. scripts/prepare-publication.ts skips the same pattern during source
# discovery so a local build sees exactly the file set CI sees.
vault/**/*.hidden.md
vault/**/*.hidden.qmd

# Generated by publication prep from the publish:true QMD allowlist.
vault/_quarto-publish.yml

# Python bytecode from the vault theme package.
__pycache__/
